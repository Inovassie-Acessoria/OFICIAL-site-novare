{
  "name": "novare-site",
  "private": true,
  "description": "Build do CSS estático (Tailwind) do site Novare Brindes",
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i ./src/css/app.css -o ./public/assets/css/app.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i ./src/css/app.css -o ./public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.17"
  }
}
